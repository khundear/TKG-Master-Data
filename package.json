{
  "name": "tkg-master-data",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@tkg/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tkg/db db:generate",
    "db:migrate": "pnpm --filter @tkg/db db:migrate",
    "db:deploy": "pnpm --filter @tkg/db db:deploy",
    "db:seed": "pnpm --filter @tkg/db db:seed",
    "db:import": "pnpm --filter @tkg/db db:import",
    "db:reset": "pnpm --filter @tkg/db db:reset",
    "check:i18n": "node tools/check-i18n.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
